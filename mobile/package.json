{
  "name": "digame-mobile",
  "version": "1.0.0",
  "description": "Digame Mobile Application",
  "main": "index.js",
  "scripts": {
    "start": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "reset": "expo start --clear && watchman watch-del-all",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:phase1b": "jest tests/Phase1B_AdvancedFeatures.test.js",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "analyze:bundle": "expo export --platform all --dev false && npx @expo/bundle-analyzer dist",
    "performance:test": "jest tests/Phase1B_AdvancedFeatures.test.js --testNamePattern='Performance Benchmarks'",
    "offline:test": "jest tests/Phase1B_AdvancedFeatures.test.js --testNamePattern='Advanced Offline Service'",
    "ai:test": "jest tests/Phase1B_AdvancedFeatures.test.js --testNamePattern='Mobile AI Service'"
  },
  "dependencies": {
    "@expo/vector-icons": "^13.0.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-vector-icons": "^10.0.0",
    "axios": "^1.6.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "13.9.0",
    "react-native-web": "~0.19.6",
    "react-dom": "18.2.0",
    "@expo/webpack-config": "^19.0.0",
    "expo-notifications": "~0.20.1",
    "expo-local-authentication": "~13.4.1",
    "expo-secure-store": "~12.3.1",
    "expo-sqlite": "~11.3.3",
    "expo-device": "~5.4.0",
    "expo-constants": "~14.4.2",
    "@react-native-community/netinfo": "9.3.10",
    "expo-background-fetch": "~11.3.0",
    "expo-task-manager": "~11.3.0",
    "expo-haptics": "~12.4.0",
    "expo-screen-orientation": "~6.0.4",
    "expo-brightness": "~11.4.0",
    "expo-keep-awake": "~12.3.0",
    "react-native-super-grid": "^4.9.6",
    "react-native-modal": "^13.0.1",
    "react-native-animatable": "^1.3.3",
    "react-native-orientation-locker": "^1.5.0",
    "react-native-device-info": "^10.11.0",
    "react-native-keychain": "^8.1.3",
    "react-native-share": "^9.4.1",
    "react-native-image-picker": "^5.6.0",
    "react-native-permissions": "^3.9.3",
    "react-native-mmkv": "^2.10.2",
    "react-native-fast-image": "^8.6.3",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-blur": "^4.3.2",
    "@react-native-netinfo/netinfo": "^9.4.1",
    "expo-speech": "~11.3.0",
    "expo-av": "~13.4.1",
    "expo-battery": "~6.0.0",
    "expo-location": "~16.1.0",
    "expo-sensors": "~12.4.0",
    "expo-file-system": "~15.4.4",
    "expo-crypto": "~12.4.1",
    "expo-application": "~5.3.0",
    "expo-network": "~5.4.0",
    "react-native-voice": "^3.2.4",
    "react-native-tts": "^4.1.0",
    "react-native-sound": "^0.11.2",
    "react-native-background-job": "^0.2.9",
    "react-native-idle-timer": "^2.1.7",
    "react-native-performance": "^5.1.0",
    "react-native-flipper": "^0.212.0",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-background-timer": "^2.4.1",
    "react-native-app-state": "^1.1.1",
    "react-native-system-setting": "^1.7.6",
    "react-native-device-brightness": "^1.0.0",
    "react-native-battery-status": "^1.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.3",
    "jest-expo": "~49.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-native": "^4.1.0",
    "@expo/bundle-analyzer": "^0.5.0",
    "babel-jest": "^29.7.0",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.jsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "private": true
}
