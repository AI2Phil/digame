# Staging Environment Configuration for Digame Platform
# Copy this file to .env.staging and update with actual staging values

# Environment Identification
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://digame_user:CHANGE_ME_STAGING_DB_PASSWORD@staging-postgres:5432/digame_staging
DB_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Security Configuration
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET_KEY_32_CHARS_MIN
ENCRYPTION_KEY=CHANGE_ME_STAGING_32_CHAR_ENCRYPTION_KEY
SESSION_TIMEOUT=3600
SESSION_REFRESH_THRESHOLD=300

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_PORT=3000

# Domain Configuration
DOMAIN=staging.digame.com
API_DOMAIN=api-staging.digame.com
APP_DOMAIN=app-staging.digame.com
MONITORING_DOMAIN=monitoring-staging.digame.com
LOGS_DOMAIN=logs-staging.digame.com

# CORS Configuration
CORS_ORIGINS=https://app-staging.digame.com,https://staging.digame.com

# Redis Configuration
REDIS_URL=redis://staging-redis:6379/0
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=staging-noreply@digame.com
SMTP_PASSWORD=CHANGE_ME_STAGING_SMTP_PASSWORD
SMTP_FROM_EMAIL=staging-noreply@digame.com
SMTP_FROM_NAME=Digame Platform (Staging)

# AWS Configuration
AWS_ACCESS_KEY_ID=CHANGE_ME_STAGING_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STAGING_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=digame-staging-storage
S3_BACKUP_BUCKET=digame-staging-backups

# File Storage Configuration
UPLOAD_MAX_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,gif
STORAGE_TYPE=s3

# Monitoring Configuration
GRAFANA_PASSWORD=CHANGE_ME_STAGING_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=15d

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=150
RATE_LIMIT_BURST=300

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE=0 3 * * *

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/staging.digame.crt
SSL_KEY_PATH=/etc/nginx/ssl/staging.digame.key

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Performance Configuration
WORKER_PROCESSES=2
WORKER_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=25

# Logging Configuration
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=50MB

# Feature Flags
FEATURE_REAL_TIME_COLLABORATION=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_AI_ML_MODELS=true
FEATURE_TEAM_MANAGEMENT=true
FEATURE_SECURITY_MONITORING=true

# Third-Party Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/STAGING/WEBHOOK

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
METRICS_COLLECTION_INTERVAL=60

# Compliance Configuration
GDPR_COMPLIANCE=true
HIPAA_COMPLIANCE=false
SOX_COMPLIANCE=false
DATA_RETENTION_DAYS=1825

# Notification Configuration
NOTIFICATION_CHANNELS=email,slack,webhook
CRITICAL_ALERT_THRESHOLD=3
HIGH_ALERT_THRESHOLD=10

# Cache Configuration
CACHE_TTL=1800
CACHE_MAX_SIZE=500
CACHE_ENABLED=true

# API Documentation (Enabled in staging for testing)
API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true

# Development/Debug (Should be false in staging)
ENABLE_CORS_ALL_ORIGINS=false
ALLOW_CREDENTIALS=true
ENABLE_PROFILING=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Staging environment under maintenance. Please try again later."

# Version Information
APP_VERSION=1.0.0-staging
BUILD_NUMBER=CHANGE_ME_STAGING_BUILD_NUMBER
DEPLOYMENT_DATE=CHANGE_ME_STAGING_DEPLOYMENT_DATE

# Testing Configuration
TEST_MODE=false
MOCK_EXTERNAL_SERVICES=false
ENABLE_TEST_ENDPOINTS=true

# Database Migration
AUTO_MIGRATE=true
SEED_DATA=true
RESET_DB_ON_DEPLOY=false