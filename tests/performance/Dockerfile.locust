# Dockerfile for Locust Performance Testing
FROM python:3.11.10-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools==70.0.0 wheel
RUN pip install --no-cache-dir -r requirements.txt

# Install additional performance testing dependencies
RUN pip install --no-cache-dir \
    locust==2.17.0 \
    requests==2.31.0 \
    psutil==5.9.6 \
    matplotlib==3.9.2 \
    pandas==2.1.4

# Copy performance test files
COPY tests/performance/ /app/tests/performance/

# Create reports directory
RUN mkdir -p /app/reports

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash --uid 1001 locust && \
    chown -R locust:locust /app

USER locust

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8089/ || exit 1

# Default command
CMD ["locust", "--help"]