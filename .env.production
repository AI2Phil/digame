# Production Environment Configuration for Digame Platform
# Copy this file to .env.production and update with actual production values

# Database Configuration
DATABASE_URL=postgresql://digame_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/digame_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Security Configuration
JWT_SECRET_KEY=CHANGE_ME_VERY_LONG_RANDOM_SECRET_KEY_FOR_JWT_TOKENS
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY_HERE

# Application Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001

# CORS Configuration
CORS_ORIGINS=https://app.digame.com,https://digame.com,https://www.digame.com

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Email Configuration (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@digame.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@digame.com
SMTP_FROM_NAME=Digame Platform

# AWS Configuration
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=digame-prod-storage
S3_BACKUP_BUCKET=digame-prod-backups

# File Storage Configuration
UPLOAD_MAX_SIZE=50MB
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,gif
STORAGE_TYPE=s3  # local, s3, or azure

# Monitoring Configuration
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d

# Security Headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Session Configuration
SESSION_TIMEOUT=3600  # 1 hour in seconds
SESSION_REFRESH_THRESHOLD=300  # 5 minutes in seconds

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/digame.crt
SSL_KEY_PATH=/etc/nginx/ssl/digame.key

# Domain Configuration
DOMAIN=digame.com
API_DOMAIN=api.digame.com
APP_DOMAIN=app.digame.com
MONITORING_DOMAIN=monitoring.digame.com
LOGS_DOMAIN=logs.digame.com

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# Performance Configuration
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
MAX_CONNECTIONS_PER_IP=50

# Logging Configuration
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90
LOG_MAX_SIZE=100MB

# Feature Flags
FEATURE_REAL_TIME_COLLABORATION=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_AI_ML_MODELS=true
FEATURE_TEAM_MANAGEMENT=true
FEATURE_SECURITY_MONITORING=true

# Third-Party Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
METRICS_COLLECTION_INTERVAL=60  # seconds

# Compliance Configuration
GDPR_COMPLIANCE=true
HIPAA_COMPLIANCE=false
SOX_COMPLIANCE=false
DATA_RETENTION_DAYS=2555  # 7 years

# Notification Configuration
NOTIFICATION_CHANNELS=email,slack,webhook
CRITICAL_ALERT_THRESHOLD=5  # minutes
HIGH_ALERT_THRESHOLD=15  # minutes

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache Configuration
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000
CACHE_ENABLED=true

# API Documentation
API_DOCS_ENABLED=false  # Disable in production for security
SWAGGER_UI_ENABLED=false

# Development/Debug (Should be false in production)
ENABLE_CORS_ALL_ORIGINS=false
ALLOW_CREDENTIALS=true
ENABLE_PROFILING=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please try again later."

# Version Information
APP_VERSION=1.0.0
BUILD_NUMBER=CHANGE_ME_BUILD_NUMBER
DEPLOYMENT_DATE=CHANGE_ME_DEPLOYMENT_DATE