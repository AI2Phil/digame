# CI Database Fix Patch
# This patch adds a database schema fix step to the CI workflow
# to handle the SQLAlchemy mapping errors and schema conflicts

--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -144,6 +144,11 @@ jobs:
           pip install -r requirements.txt
           pip install -r requirements-dev.txt
 
+      - name: Fix database schema
+        env:
+          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/test_db
+        run: |
+          python fix_database_schema.py
+
       - name: Run database migrations
         env:
           DATABASE_URL: postgresql://postgres:postgres@localhost:5432/test_db
@@ -279,6 +284,11 @@ jobs:
       - name: Setup database
         env:
           DATABASE_URL: postgresql://postgres:postgres@localhost:5432/e2e_test_db
+        run: |
+          python fix_database_schema.py
+
+      - name: Run database migrations
+        env:
+          DATABASE_URL: postgresql://postgres:postgres@localhost:5432/e2e_test_db
         run: |
           alembic upgrade heads