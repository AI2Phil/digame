# Digame Platform - Production Environment Variables
# Copy this file to .env.production and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NEXT_PUBLIC_API_URL=https://api.digame.com
NEXT_PUBLIC_APP_URL=https://app.digame.com
NEXT_PUBLIC_WS_URL=wss://api.digame.com/ws

# Performance Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_REAL_TIME_MONITORING=true
NEXT_PUBLIC_BUNDLE_ANALYZER=false

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id
NEXT_PUBLIC_SENTRY_DSN=your-frontend-sentry-dsn

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://digame_user:your-db-password@db:5432/digame_prod
DB_PASSWORD=your-secure-database-password

# Connection Pool Settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =============================================================================
# CORS SETTINGS
# =============================================================================
ALLOWED_ORIGINS=["https://app.digame.com"]
ALLOWED_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
ALLOWED_HEADERS=["*"]

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=your-backend-sentry-dsn

# Performance Monitoring
PERFORMANCE_MONITORING=true
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true
SMTP_SSL=false

# Email Templates
FROM_EMAIL=noreply@digame.com
FROM_NAME=Digame Platform

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=digame-assets

# Google OAuth (if using Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (if using GitHub authentication)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_API_RATE_LIMITING=true
ENABLE_REAL_TIME_FEATURES=true
ENABLE_AI_INSIGHTS=true
ENABLE_WORKFLOW_AUTOMATION=true

# =============================================================================
# MONITORING SERVICES
# =============================================================================

# Grafana
GRAFANA_PASSWORD=your-grafana-admin-password

# Prometheus
PROMETHEUS_RETENTION_TIME=200h

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=digame-backups

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private
SSL_VERIFY=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# API Specific Rate Limits
API_RATE_LIMIT=100
AUTH_RATE_LIMIT=5
UPLOAD_RATE_LIMIT=10

# =============================================================================
# CACHING
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# DEVELOPMENT/TESTING (set to false in production)
# =============================================================================
ENABLE_CORS_ALL_ORIGINS=false
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false
SKIP_AUTH_FOR_TESTING=false

# =============================================================================
# CUSTOM APPLICATION SETTINGS
# =============================================================================

# Tenant Settings
DEFAULT_TENANT_ID=1
MAX_TENANTS_PER_USER=5
TENANT_ISOLATION_ENABLED=true

# Performance Settings
MAX_UPLOAD_SIZE=50MB
MAX_REQUEST_SIZE=100MB
REQUEST_TIMEOUT=300

# AI/ML Settings
AI_MODEL_ENDPOINT=https://api.openai.com/v1
AI_MODEL_API_KEY=your-openai-api-key
AI_INSIGHTS_ENABLED=true
PREDICTIVE_ANALYTICS_ENABLED=true

# Workflow Automation
WORKFLOW_AUTOMATION_ENABLED=true
MAX_CONCURRENT_WORKFLOWS=10
WORKFLOW_TIMEOUT=3600

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Password Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# Session Settings
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS=true
PUSH_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=your-slack-webhook-url

# =============================================================================
# ANALYTICS & TRACKING
# =============================================================================
ANALYTICS_ENABLED=true
USER_TRACKING_ENABLED=true
PERFORMANCE_TRACKING_ENABLED=true
ERROR_TRACKING_ENABLED=true

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System is under maintenance. Please try again later."
MAINTENANCE_ALLOWED_IPS=["127.0.0.1", "::1"]