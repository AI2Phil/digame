# Digital Twin Platform - Frontend Production Dockerfile
# Multi-stage build for optimized production image

# Build stage
FROM node:22.12.0-alpine3.20 AS builder

# Set working directory
WORKDIR /app

# Install security updates and build dependencies
RUN apk update && apk upgrade && apk add --no-cache \
    ca-certificates \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --only=production --audit

# Copy source code
COPY frontend/ ./

# Build the application
RUN npm run build

# Production stage
FROM nginx:1.27.3-alpine3.20 AS production

# Install security updates and minimal runtime dependencies
RUN apk update && apk upgrade && apk add --no-cache \
    curl \
    ca-certificates \
    tzdata \
    && apk del --no-cache \
    && rm -rf /var/cache/apk/* /tmp/* /var/tmp/*

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built application from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user with specific UID/GID
RUN addgroup -g 1001 -S appuser && \
    adduser -S -D -H -u 1001 -h /var/cache/nginx -s /sbin/nologin -G appuser appuser

# Set proper permissions and security hardening
RUN chown -R appuser:appuser /usr/share/nginx/html && \
    chown -R appuser:appuser /var/cache/nginx && \
    chown -R appuser:appuser /var/log/nginx && \
    chown -R appuser:appuser /etc/nginx/conf.d && \
    chmod -R 755 /usr/share/nginx/html && \
    chmod -R 750 /var/cache/nginx /var/log/nginx

# Create pid file directory with proper permissions
RUN mkdir -p /var/run/nginx && \
    chown -R appuser:appuser /var/run/nginx && \
    chmod 755 /var/run/nginx

# Remove any potential security risks
RUN rm -rf /tmp/* /var/tmp/* /var/cache/apk/* && \
    find /usr/share/nginx/html -type f -name "*.map" -delete || true

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]