{
  "name": "digame-frontend",
  "version": "1.0.0",
  "description": "Digame Frontend - Advanced Analytics & Visualization Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:security": "eslint . --ext .js,.jsx,.ts,.tsx --config .eslintrc.security.json || true",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathPattern=unit --passWithNoTests",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:full": "../scripts/setup-test-env.sh && playwright test && ../scripts/cleanup-test-env.sh",
    "test:e2e:setup": "../scripts/setup-test-env.sh",
    "test:e2e:cleanup": "../scripts/cleanup-test-env.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze:bundle": "npm run build:analyze",
    "serve:dist": "npx serve dist -p 3000",
    "test:performance": "npm run build && npm run lighthouse",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html --chrome-flags='--headless'",
    "performance:audit": "npm run build:analyze && npm run lighthouse",
    "optimize": "npm run lint:fix && npm run type-check && npm run test:coverage && npm run build:analyze",
    "bundle:analyze": "npx webpack-bundle-analyzer .next/static/chunks/*.js",
    "clean": "rm -rf .next out node_modules/.cache",
    "reinstall": "npm run clean && npm install",
    "generate:icons": "node scripts/generate-icons.js",
    "pwa:build": "npm run generate:icons && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@mui/x-data-grid": "^6.18.2",
    "@mui/x-date-pickers": "^6.18.2",
    "@nextui-org/react": "^2.6.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/postcss": "^4.1.11",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-query-devtools": "^5.8.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.6.2",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "d3": "^7.8.5",
    "date-fns": "^2.30.0",
    "i18next": "^23.7.16",
    "lodash": "^4.17.21",
    "lucide-react": "^0.523.0",
    "moment": "^2.29.4",
    "next": "^14.0.3",
    "next-i18next": "^15.2.0",
    "next-pwa": "^5.6.0",
    "notistack": "^3.0.1",
    "plotly.js": "^2.27.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.4.4",
    "react-hook-form": "^7.48.2",
    "react-i18next": "^14.0.0",
    "react-plotly.js": "^2.6.0",
    "recharts": "^2.8.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.10",
    "uuid": "^9.0.1",
    "web-vitals": "^5.0.3",
    "zustand": "^4.4.7",
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.19.2",
    "@types/plotly.js": "^2.12.29",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-plotly.js": "^2.6.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "serve": "^14.2.1",
    "sharp": "^0.33.1",
    "storybook": "^8.6.14"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
